PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_your_local_mysql_password
DB_NAME=alumni_system
SESSION_SECRET=replace_with_a_long_random_secret
NODE_ENV=development

# SMTP configuration (Gmail App Password or institutional SMTP server)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM="Alumni Connect <your_email@example.com>"
