<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Change Password - Alumni Connect</title><link rel="stylesheet" href="/style.css"></head>
<body><main class="auth-page"><section class="auth-card"><div class="brand">Alumni Connect</div><h1>Change Password</h1>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<form action="/change-password" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="form-group"><label>Current Password</label><input type="password" name="current_password" autocomplete="current-password" required></div>
<div class="form-group"><label>New Password</label><input type="password" name="new_password" minlength="8" autocomplete="new-password" required></div>
<div class="form-group"><label>Confirm New Password</label><input type="password" name="confirm_password" minlength="8" autocomplete="new-password" required></div>
<button class="btn" type="submit">Update Password</button></form><p class="auth-link"><a href="/profile">Back to Profile</a></p></section></main></body></html>