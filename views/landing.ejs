<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <meta name="description" content="Alumni Connect brings graduates together to reconnect, share opportunities and strengthen the university community.">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body class="landing-page">
  <header class="landing-header">
    <a class="landing-brand" href="/" aria-label="Alumni Connect home">
      <img class="landing-logo" src="/images/iba-alumni-connect.svg" alt="IBA Alumni Connect">
    </a>
    <nav class="landing-nav" aria-label="Main navigation">
      <a href="#about">About</a>
      <a href="#community">Community</a>
      <a href="#events">Events</a>
      <a href="#opportunities">Opportunities</a>
    </nav>
    <div class="landing-actions">
      <a class="landing-login" href="/signin">Log in</a>
      <a class="landing-join" href="/signup">Join the network <span aria-hidden="true">↗</span></a>
    </div>
  </header>

  <main>
    <section class="landing-hero">
      <div class="hero-photo" role="img" aria-label="University campus and students walking together"></div>
      <div class="hero-shade"></div>
      <div class="hero-content">
        <div class="eyebrow"><span></span> A lifelong connection to your university</div>
        <h1>Where your <em>journey</em><br>continues together.</h1>
        <p>Reconnect with classmates, meet fellow graduates, discover career opportunities and stay part of the community that helped shape your future.</p>
        <div class="hero-buttons">
          <a class="hero-primary" href="/signup">Become a member <span aria-hidden="true">→</span></a>
          <a class="hero-secondary" href="/signin">Member sign in</a>
        </div>
        <div class="hero-note"><span class="hero-note-line"></span> One community. Many paths. Shared beginnings.</div>
      </div>
      <div class="hero-caption"><span>ALUMNI COMMUNITY</span><span>CONNECTED BEYOND GRADUATION</span></div>
    </section>

    <section class="landing-stats" aria-label="Alumni Connect community statistics">
      <div class="landing-stat"><strong><%= Number(stats.total_alumni || 0).toLocaleString() %></strong><span>Registered alumni</span></div>
      <div class="landing-stat"><strong><%= Number(stats.total_departments || 0).toLocaleString() %></strong><span>Departments represented</span></div>
      <div class="landing-stat"><strong><%= Number(stats.upcoming_events || 0).toLocaleString() %></strong><span>Upcoming events</span></div>
      <div class="landing-stat"><strong><%= Number(stats.total_jobs || 0).toLocaleString() %></strong><span>Career opportunities</span></div>
    </section>

    <section class="landing-section about-section" id="about">
      <div class="section-kicker">MORE THAN A DIRECTORY</div>
      <div class="about-grid">
        <div><h2>A community that<br><em>moves forward</em>.</h2></div>
        <div class="about-copy"><p>Graduation is a milestone, not a goodbye. Alumni Connect makes it easier to keep meaningful relationships alive, learn from each other's experiences and find new ways to grow.</p><a class="text-link" href="/signup">Be part of the community <span>→</span></a></div>
      </div>
      <div class="feature-grid" id="community">
        <article class="feature-card"><span class="feature-number">01</span><div class="feature-icon">◎</div><h3>Find your people</h3><p>Discover graduates across departments, batches and professional backgrounds.</p></article>
        <article class="feature-card"><span class="feature-number">02</span><div class="feature-icon">↗</div><h3>Grow your career</h3><p>Explore opportunities and learn about openings shared with the alumni network.</p></article>
        <article class="feature-card"><span class="feature-number">03</span><div class="feature-icon">◇</div><h3>Stay involved</h3><p>Keep up with reunions, university activities and events that bring the community together.</p></article>
      </div>
    </section>

    <section class="landing-section community-section">
      <div class="landing-section-heading"><div><div class="section-kicker">THE PEOPLE BEHIND THE NETWORK</div><h2>Recently joined <em>alumni</em></h2></div><a class="text-link" href="/signup">Join them <span>→</span></a></div>
      <% if (recentAlumni.length) { %>
        <div class="landing-people">
          <% recentAlumni.forEach(person => { %>
            <article class="person-card">
              <% if (person.profile_photo) { %><img src="<%= person.profile_photo %>" alt="" loading="lazy"><% } else { %><div class="person-placeholder"><%= person.full_name.charAt(0).toUpperCase() %></div><% } %>
              <div class="person-info"><h3><%= person.full_name %></h3><p><%= person.current_job || person.department || "Alumni member" %></p><span><%= [person.company, person.city, person.graduation_year].filter(Boolean).join(" · ") %></span></div>
            </article>
          <% }) %>
        </div>
      <% } else { %><div class="landing-empty">Your alumni community is getting started. Be among the first to join.</div><% } %>
    </section>

    <section class="landing-section activity-section" id="events">
      <div class="landing-section-heading"><div><div class="section-kicker">WHAT'S HAPPENING</div><h2>Community <em>updates</em></h2></div></div>
      <div class="activity-grid">
        <div class="activity-column"><div class="activity-heading"><h3>Upcoming events</h3><span>EVENTS</span></div>
          <% if (upcomingEvents.length) { %><% upcomingEvents.forEach(event => { %>
            <article class="activity-item"><div class="activity-date"><strong><%= new Date(event.event_date).toLocaleDateString("en", {day:"2-digit"}) %></strong><span><%= new Date(event.event_date).toLocaleDateString("en", {month:"short"}) %></span></div><div><h4><%= event.title %></h4><p><%= event.location %></p><% if (event.description) { %><small><%= event.description %></small><% } %></div></article>
          <% }) %><% } else { %><div class="landing-empty">New community events will appear here when announced.</div><% } %>
        </div>
        <div class="activity-column" id="opportunities"><div class="activity-heading"><h3>Career opportunities</h3><span>CAREERS</span></div>
          <% if (latestJobs.length) { %><% latestJobs.forEach(job => { %>
            <article class="job-item"><div class="job-symbol">↗</div><div><h4><%= job.title %></h4><p><%= job.company %><% if (job.location) { %> · <%= job.location %><% } %></p><% if (job.description) { %><small><%= job.description %></small><% } %></div></article>
          <% }) %><% } else { %><div class="landing-empty">Career opportunities shared by the network will appear here.</div><% } %>
        </div>
      </div>
      <p class="landing-disclaimer">Sign in to explore the full alumni directory, events and opportunities.</p>
    </section>

    <section class="landing-cta">
      <div><div class="section-kicker">YOUR NEXT CHAPTER STARTS HERE</div><h2>Keep the connection<br><em>going.</em></h2></div>
      <div class="cta-copy"><p>Reconnect with familiar faces and meet the people who can help shape what comes next.</p><a class="hero-primary" href="/signup">Join Alumni Connect <span>→</span></a></div>
    </section>
  </main>

  <footer class="landing-footer"><a class="landing-brand footer-brand" href="/"><img class="landing-logo" src="/images/iba-alumni-connect-light.svg" alt="IBA Alumni Connect"></a><div>Building meaningful connections beyond graduation.</div><a href="/contact">Contact us ↗</a><span>© <%= new Date().getFullYear() %> Alumni Connect</span></footer>
</body>
</html>
