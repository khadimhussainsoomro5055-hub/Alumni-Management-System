<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>Dashboard - Alumni Connect</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="app-header">
    <a class="logo" href="/dashboard"><img class="site-logo" src="/images/iba-alumni-connect.svg" alt="IBA Alumni Connect"></a>
    <div class="header-right">
      <span class="header-name"><%= sessionUser ? sessionUser.full_name : "" %></span>

      <% if (sessionUser && sessionUser.profile_photo) { %>
        <img class="header-avatar" src="<%= sessionUser.profile_photo %>">
      <% } else { %>
        <div class="header-avatar-fallback">
          <%= sessionUser ? sessionUser.full_name.charAt(0).toUpperCase() : "A" %>
        </div>
      <% } %>

      <form action="/logout" method="POST" style="display:inline">
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="logout" type="submit">Logout</button></form>
    </div>
  </header>

  <div class="layout">
    <aside class="sidebar">
      <div class="sidebar-title">Main Menu</div>
      <% if (sessionUser && sessionUser.role === "admin") { %><a class="nav-item" href="/admin">Admin Dashboard</a><% } %>
      <a class="nav-item active" href="/dashboard">Dashboard</a>
      <a class="nav-item" href="/alumni">Alumni Directory</a>
      <a class="nav-item" href="/events">Events</a>
      <a class="nav-item" href="/jobs">Jobs &amp; Opportunities</a>

      <div class="sidebar-title">Account</div>
      <a class="nav-item" href="/profile">My Profile</a>

    </aside>

    <main class="main dashboard-main">
      <section class="dashboard-welcome">
        <div class="dashboard-welcome-copy">
          <span class="dashboard-kicker">IBA ALUMNI CONNECT</span>
          <h1>Welcome back, <em><%= sessionUser.full_name.split(" ")[0] %>.</em></h1>
          <p>Your community, career opportunities and university connections — all in one place.</p>
          <a class="dashboard-welcome-link" href="/profile">Manage your profile <span>→</span></a>
        </div>
        <div class="dashboard-welcome-art" aria-hidden="true">
          <span class="welcome-orbit orbit-one"></span><span class="welcome-orbit orbit-two"></span>
          <span class="welcome-monogram">IBA</span><span class="welcome-caption">CONNECTED<br>BEYOND GRADUATION</span>
        </div>
      </section>

      <div class="dashboard-section-intro"><div><span class="dashboard-kicker">YOUR COMMUNITY AT A GLANCE</span><h2>Community overview</h2></div><span class="dashboard-updated">Live platform statistics</span></div>
      <section class="dashboard-stat-grid">
        <article class="dashboard-stat alumni-stat"><div class="dashboard-stat-top"><span class="dashboard-stat-icon">♧</span><span class="dashboard-stat-label">NETWORK</span></div><strong><%= stats.total_alumni %></strong><h3>Registered alumni</h3><p>Graduates in your community</p></article>
        <article class="dashboard-stat events-stat"><div class="dashboard-stat-top"><span class="dashboard-stat-icon">▦</span><span class="dashboard-stat-label">CAMPUS LIFE</span></div><strong><%= stats.total_events %></strong><h3>Events listed</h3><p>Opportunities to reconnect</p></article>
        <article class="dashboard-stat jobs-stat"><div class="dashboard-stat-top"><span class="dashboard-stat-icon">↗</span><span class="dashboard-stat-label">CAREER</span></div><strong><%= stats.total_jobs %></strong><h3>Job opportunities</h3><p>Roles shared by the network</p></article>
      </section>

      <section class="dashboard-community-section">
        <div class="dashboard-section-intro"><div><span class="dashboard-kicker">GROW YOUR NETWORK</span><h2>Recently joined alumni</h2><p>Get to know the latest members of the Sukkur IBA alumni community.</p></div><a class="dashboard-section-link" href="/alumni">Explore directory <span>→</span></a></div>
        <% if (recent.length) { %>
        <div class="dashboard-alumni-grid">
          <% recent.forEach(a => { %>
            <article class="dashboard-alumni-card">
              <% if (a.profile_photo) { %><img class="dashboard-alumni-avatar" src="<%= a.profile_photo %>" alt="<%= a.full_name %>" loading="lazy"><% } else { %><div class="dashboard-alumni-avatar avatar-fallback"><%= a.full_name.charAt(0).toUpperCase() %></div><% } %>
              <div class="dashboard-alumni-info"><h3><%= a.full_name %></h3><p>Member of the Sukkur IBA alumni community</p><div class="dashboard-alumni-tags"><span><%= a.department || "Sukkur IBA" %></span><span>Class of <%= a.graduation_year || "—" %></span></div></div>
            </article>
          <% }) %>
        </div>
        <% } else { %><div class="empty-state"><strong>Your alumni community is growing</strong><p>New members will appear here after they join.</p></div><% } %>
      </section>
    </main>ain>
  </div>

<footer class="app-footer"><a href="/" class="app-footer-brand">IBA Alumni Connect</a><span>Sukkur IBA alumni, connected beyond graduation.</span><div class="app-footer-links"><a href="/contact">Contact</a><a href="/dashboard">Dashboard</a></div><small>© <%= new Date().getFullYear() %> Alumni Connect</small></footer>
</body>
</html>