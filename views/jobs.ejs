<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>Jobs - Alumni Connect</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="app-header">
    <a class="logo" href="/dashboard"><img class="site-logo" src="/images/iba-alumni-connect.svg" alt="IBA Alumni Connect"></a>
    <div class="header-right">
      <span class="header-name"><%= sessionUser ? sessionUser.full_name : "" %></span>

      <% if (sessionUser && sessionUser.profile_photo) { %>
        <img class="header-avatar" src="<%= sessionUser.profile_photo %>">
      <% } else { %>
        <div class="header-avatar-fallback">
          <%= sessionUser ? sessionUser.full_name.charAt(0).toUpperCase() : "A" %>
        </div>
      <% } %>

      <form action="/logout" method="POST" style="display:inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="logout" type="submit">Logout</button>
      </form>
    </div>
  </header>

  <div class="layout">
    <aside class="sidebar">
      <div class="sidebar-title">Main Menu</div>
      <% if (sessionUser && sessionUser.role === "admin") { %><a class="nav-item" href="/admin">Admin Dashboard</a><% } %>
      <a class="nav-item" href="/dashboard">Dashboard</a>
      <a class="nav-item" href="/alumni">Alumni Directory</a>
      <a class="nav-item" href="/events">Events</a>
      <a class="nav-item active" href="/jobs">Jobs &amp; Opportunities</a>

      <div class="sidebar-title">Account</div>
      <a class="nav-item" href="/profile">My Profile</a>

    </aside>

    <main class="main listing-main jobs-main">
      <% if (featuredJob) { %>
      <section class="listing-page-hero listing-feature-hero jobs-feature-hero">
        <div class="listing-hero-copy">
          <span class="dashboard-kicker">LATEST CAREER OPPORTUNITY</span>
          <h1><%= featuredJob.title %></h1>
          <p class="feature-job-company"><%= featuredJob.company %></p>
          <p><%= featuredJob.description || "A new opportunity shared through the Sukkur IBA alumni network. Explore the role and take your next professional step." %></p>
          <div class="listing-hero-meta"><span>⌖</span><%= featuredJob.location || "Location not specified" %><span>◷</span>Posted <%= new Date(featuredJob.posted_at).toLocaleDateString("en", {month:"short",day:"numeric",year:"numeric"}) %></div>
        </div>
        <div class="feature-hero-side feature-job-side"><span class="feature-hero-label">NEW OPPORTUNITY</span><strong>CAREER</strong><span><%= featuredJob.company %></span></div>
      </section>
      <% } else { %>
      <section class="listing-page-hero listing-feature-hero jobs-feature-hero jobs-feature-empty"><div class="listing-hero-copy"><span class="dashboard-kicker">CAREER & PROFESSIONAL GROWTH</span><h1>Opportunities at Sukkur IBA</h1><p>No job has been posted yet. The latest opportunity will appear here as soon as it is shared.</p></div></section>
      <% } %>
      <div class="listing-toolbar"><div><span class="dashboard-kicker">TAKE THE NEXT STEP</span><h2>Career opportunities</h2></div><label class="listing-search"><span>⌕</span><input type="search" id="jobSearch" placeholder="Search roles, companies or locations..." aria-label="Search job opportunities"></label></div>
      <% if (jobs.length) { %>
      <div class="jobs-grid listing-page-grid" id="jobGrid">
        <% jobs.forEach(j => { %>
          <article class="listing-card job-card" data-search="<%= (j.title + ' ' + j.company + ' ' + (j.location || '') + ' ' + (j.description || '')).toLowerCase() %>">
            <div class="listing-image-wrap">
              <% if (j.image_url) { %><img src="<%= j.image_url %>" alt="<%= j.title %>" loading="lazy"><% } else { %><div class="listing-image-placeholder job-placeholder"><span>CAREER OPPORTUNITY</span></div><% } %>
              <span class="listing-type">OPEN OPPORTUNITY</span>
            </div>
            <div class="listing-card-body"><div class="listing-eyebrow">CAREER OPPORTUNITY</div><h2><%= j.title %></h2><p class="listing-company"><%= j.company %></p><p class="listing-meta"><span>⌖</span> <%= j.location || "Location not specified" %></p><% if (j.description) { %><p class="listing-description"><%= j.description %></p><% } %><div class="listing-card-bottom"><span class="listing-card-category">SHARED BY THE NETWORK</span><span class="listing-card-arrow" aria-hidden="true">↗</span></div></div>
          </article>
        <% }) %>
      </div>
      <p class="listing-no-results" id="jobNoResults" hidden>No opportunities match your search. Try another role, company or location.</p>
      <% } else { %><div class="listing-empty-feature"><span class="empty-feature-icon">↗</span><strong>Your next opportunity could be just around the corner.</strong><p>No jobs have been shared yet. New opportunities posted by the alumni community will appear here.</p></div><% } %>
      <script>
        (() => { const input = document.getElementById("jobSearch"); const cards = [...document.querySelectorAll("#jobGrid [data-search]")]; const empty = document.getElementById("jobNoResults"); if (!input) return; input.addEventListener("input", () => { const q = input.value.trim().toLowerCase(); let visible = 0; cards.forEach(card => { const match = card.dataset.search.includes(q); card.hidden = !match; if (match) visible++; }); if (empty) empty.hidden = visible !== 0; }); })();
      </script>
    </main>
  </div>

<footer class="app-footer">
  <a href="/" class="app-footer-brand">IBA Alumni Connect</a>
  <span>Sukkur IBA alumni, connected beyond graduation.</span>
  <div class="app-footer-links"><a href="/contact">Contact</a><a href="/dashboard">Dashboard</a></div>
  <small>© <%= new Date().getFullYear() %> Alumni Connect</small>
</footer>
</body>
</html>