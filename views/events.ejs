<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>Events - Alumni Connect</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="app-header">
    <a class="logo" href="/dashboard"><img class="site-logo" src="/images/iba-alumni-connect-light.svg" alt="IBA Alumni Connect"></a>
    <div class="header-right">
      <span class="header-name"><%= sessionUser ? sessionUser.full_name : "" %></span>

      <% if (sessionUser && sessionUser.profile_photo) { %>
        <img class="header-avatar" src="<%= sessionUser.profile_photo %>">
      <% } else { %>
        <div class="header-avatar-fallback">
          <%= sessionUser ? sessionUser.full_name.charAt(0).toUpperCase() : "A" %>
        </div>
      <% } %>

      <form action="/logout" method="POST" style="display:inline">
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="logout" type="submit">Logout</button></form>
    </div>
  </header>

  <div class="layout">
    <aside class="sidebar">
      <div class="sidebar-title">Main Menu</div>
      <% if (sessionUser && sessionUser.role === "admin") { %><a class="nav-item" href="/admin">Admin Dashboard</a><% } %>
      <a class="nav-item" href="/dashboard">Dashboard</a>
      <a class="nav-item" href="/alumni">Alumni Directory</a>
      <a class="nav-item active" href="/events">Events</a>
      <a class="nav-item" href="/jobs">Jobs &amp; Opportunities</a>

      <div class="sidebar-title">Account</div>
      <a class="nav-item" href="/profile">My Profile</a>

    </aside>

    <main class="main">
      <div class="page-head">
        <div>
          <h1>Events</h1>
          <p class="muted">Upcoming alumni and university events.</p>
        </div>
      </div>

      <% if (events.length) { %>
      <div class="events-grid listing-page-grid">
        <% events.forEach(e => { %>
          <article class="listing-card">
            <div class="listing-image-wrap">
              <% if (e.image_url) { %><img src="<%= e.image_url %>" alt="<%= e.title %>" loading="lazy"><% } else { %><div class="listing-image-placeholder event-placeholder"><span>ALUMNI COMMUNITY EVENT</span></div><% } %>
              <div class="listing-date"><strong><%= new Date(e.event_date).toLocaleDateString("en", {day:"2-digit"}) %></strong><span><%= new Date(e.event_date).toLocaleDateString("en", {month:"short"}) %></span></div>
            </div>
            <div class="listing-card-body"><div class="listing-eyebrow">COMMUNITY EVENT</div><h2><%= e.title %></h2><p class="listing-meta"><span>⌖</span> <%= e.location %></p><p class="listing-meta"><span>◷</span> <%= new Date(e.event_date).toLocaleString() %></p><% if (e.description) { %><p class="listing-description"><%= e.description %></p><% } %></div>
          </article>
        <% }) %>
      </div>
      <% } else { %>
        <div class="empty-state"><strong>No events are available right now</strong><p>Please check back later for alumni and university events.</p></div>
      <% } %>
    </main>
  </div>
</body>
</html>