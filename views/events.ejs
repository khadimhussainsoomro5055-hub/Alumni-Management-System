<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>Events - Alumni Connect</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="app-header">
    <a class="logo" href="/dashboard"><img class="site-logo" src="/images/iba-alumni-connect.svg" alt="IBA Alumni Connect"></a>
    <div class="header-right">
      <span class="header-name"><%= sessionUser ? sessionUser.full_name : "" %></span>

      <% if (sessionUser && sessionUser.profile_photo) { %>
        <img class="header-avatar" src="<%= sessionUser.profile_photo %>">
      <% } else { %>
        <div class="header-avatar-fallback">
          <%= sessionUser ? sessionUser.full_name.charAt(0).toUpperCase() : "A" %>
        </div>
      <% } %>

      <form action="/logout" method="POST" style="display:inline">
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="logout" type="submit">Logout</button></form>
    </div>
  </header>

  <div class="layout">
    <aside class="sidebar">
      <div class="sidebar-title">Main Menu</div>
      <% if (sessionUser && sessionUser.role === "admin") { %><a class="nav-item" href="/admin">Admin Dashboard</a><% } %>
      <a class="nav-item" href="/dashboard">Dashboard</a>
      <a class="nav-item" href="/alumni">Alumni Directory</a>
      <a class="nav-item active" href="/events">Events</a>
      <a class="nav-item" href="/jobs">Jobs &amp; Opportunities</a>

      <div class="sidebar-title">Account</div>
      <a class="nav-item" href="/profile">My Profile</a>

    </aside>

    <main class="main listing-main events-main">
      <% if (featuredEvent) { %>
      <section class="listing-page-hero listing-feature-hero events-feature-hero" style="<%= featuredEvent.image_url ? "background-image:linear-gradient(90deg,rgba(12,29,46,.94) 0%,rgba(12,29,46,.78) 48%,rgba(12,29,46,.2) 100%),url('" + featuredEvent.image_url.replace(/'/g, "%27") + "')" : "" %>">
        <div class="listing-hero-copy">
          <span class="dashboard-kicker">FEATURED COMMUNITY EVENT</span>
          <h1><%= featuredEvent.title %></h1>
          <p><%= featuredEvent.description || "Be part of the next Sukkur IBA alumni gathering. Meet your community, share experiences and reconnect." %></p>
          <div class="listing-hero-meta"><span>◷</span><%= new Date(featuredEvent.event_date).toLocaleDateString("en", {weekday:"long",month:"long",day:"numeric",year:"numeric"}) %><span>⌖</span><%= featuredEvent.location %></div>
        </div>
        <div class="feature-hero-side"><span class="feature-hero-label">UPCOMING EVENT</span><strong><%= new Date(featuredEvent.event_date).toLocaleDateString("en", {day:"2-digit"}) %></strong><span><%= new Date(featuredEvent.event_date).toLocaleDateString("en", {month:"long",year:"numeric"}) %></span></div>
      </section>
      <% } else { %>
      <section class="listing-page-hero listing-feature-hero events-feature-hero events-feature-empty"><div class="listing-hero-copy"><span class="dashboard-kicker">CAMPUS & COMMUNITY</span><h1>Events at Sukkur IBA</h1><p>There are no events listed yet. When a new gathering is added, it will be featured here.</p></div></section>
      <% } %>
      <div class="listing-toolbar"><div><span class="dashboard-kicker">WHAT'S HAPPENING</span><h2>Explore events</h2></div><label class="listing-search"><span>⌕</span><input type="search" id="eventSearch" placeholder="Search events or locations..." aria-label="Search events"></label></div>
      <% if (events.length) { %>
      <div class="events-grid listing-page-grid" id="eventGrid">
        <% events.forEach(e => { %>
          <article class="listing-card event-feature-card" data-search="<%= (e.title + ' ' + e.location + ' ' + (e.description || '')).toLowerCase() %>">
            <div class="listing-image-wrap">
              <% if (e.image_url) { %><img src="<%= e.image_url %>" alt="<%= e.title %>" loading="lazy"><% } else { %><div class="listing-image-placeholder event-placeholder"><span>IBA ALUMNI COMMUNITY</span></div><% } %>
              <div class="listing-date"><strong><%= new Date(e.event_date).toLocaleDateString("en", {day:"2-digit"}) %></strong><span><%= new Date(e.event_date).toLocaleDateString("en", {month:"short"}) %></span></div>
              <span class="listing-photo-label">COMMUNITY EVENT</span>
            </div>
            <div class="listing-card-body"><div class="event-card-date"><span>◷</span><%= new Date(e.event_date).toLocaleDateString("en", {weekday:"long",month:"long",day:"numeric",year:"numeric"}) %></div><h2><%= e.title %></h2><p class="listing-meta"><span>⌖</span> <%= e.location %></p><% if (e.description) { %><p class="listing-description"><%= e.description %></p><% } %><div class="listing-card-bottom"><span class="listing-card-category">ALUMNI CONNECT</span><span class="listing-card-arrow" aria-hidden="true">↗</span></div></div>
          </article>
        <% }) %>
      </div>
      <p class="listing-no-results" id="eventNoResults" hidden>No events match your search. Try another title or location.</p>
      <% } else { %><div class="listing-empty-feature"><span class="empty-feature-icon">▦</span><strong>Something worth celebrating is on its way.</strong><p>There are no events listed at the moment. Check back soon for upcoming alumni and university gatherings.</p></div><% } %>
      <script>
        (() => { const input = document.getElementById("eventSearch"); const cards = [...document.querySelectorAll("#eventGrid [data-search]")]; const empty = document.getElementById("eventNoResults"); if (!input) return; input.addEventListener("input", () => { const q = input.value.trim().toLowerCase(); let visible = 0; cards.forEach(card => { const match = card.dataset.search.includes(q); card.hidden = !match; if (match) visible++; }); if (empty) empty.hidden = visible !== 0; }); })();
      </script>
    </main>
  </div>

<footer class="app-footer"><a href="/" class="app-footer-brand">IBA Alumni Connect</a><span>Sukkur IBA alumni, connected beyond graduation.</span><div class="app-footer-links"><a href="/contact">Contact</a><a href="/dashboard">Dashboard</a></div><small>© <%= new Date().getFullYear() %> Alumni Connect</small></footer>
</body>
</html>