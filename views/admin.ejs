<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Admin Dashboard - Alumni Connect</title><link rel="stylesheet" href="/style.css">
<style>
.admin-actions{display:flex;gap:8px;flex-wrap:wrap}.admin-actions form{display:inline}.admin-table{min-width:720px}
.admin-table .btn{padding:7px 10px;font-size:13px}.section-head{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.sidebar form{margin:0}.sidebar button{width:100%;border:0;background:transparent;text-align:left;cursor:pointer;font:inherit}
</style>
</head>
<body>
<header class="app-header"><a class="logo" href="/admin">Alumni Connect · Admin</a><div class="header-right"><span class="header-name"><%= sessionUser.full_name %></span><form action="/logout" method="POST">
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="logout" type="submit">Logout</button></form></div></header>
<div class="layout"><aside class="sidebar">
<div class="sidebar-title">Administration</div><a class="nav-item active" href="/admin">Admin Dashboard</a>
<div class="sidebar-title">Alumni Area</div><a class="nav-item" href="/dashboard">User Dashboard</a><a class="nav-item" href="/alumni">Alumni Directory</a><a class="nav-item" href="/events">Events</a><a class="nav-item" href="/jobs">Jobs</a>
</aside>
<main class="main"><div class="page-head"><div><h1>Administration</h1><p class="muted">Manage alumni accounts, events and job opportunities.</p></div></div>
<div class="cards">
<div class="stat-card"><h3>Total Alumni</h3><div class="number"><%= stats.alumni_count %></div></div>
<div class="stat-card"><h3>Events</h3><div class="number"><%= stats.event_count %></div></div>
<div class="stat-card"><h3>Jobs</h3><div class="number"><%= stats.job_count %></div></div>
</div>
<section class="panel"><div class="section-head"><h2>Alumni Accounts</h2></div><div class="table-wrap"><table class="admin-table"><thead><tr><th>Name</th><th>Email</th><th>Department</th><th>Batch</th><th>Role</th><th>Actions</th></tr></thead><tbody>
<% alumni.forEach(person => { %><tr><td><%= person.full_name %></td><td><%= person.email %></td><td><%= person.department %></td><td><%= person.graduation_year %></td><td><%= person.role || "alumni" %></td><td><div class="admin-actions"><a class="btn" href="/admin/alumni/<%= person.id %>/edit">Edit</a><% if (Number(person.id) !== Number(sessionUser.id)) { %><form method="POST" action="/admin/alumni/<%= person.id %>
<input type="hidden" name="_csrf" value="<%= csrfToken %>">/delete" onsubmit="return confirm('Delete this alumni account?')"><button class="btn danger" type="submit">Delete</button></form><% } %></div></td></tr><% }) %>
<% if (!alumni.length) { %><tr><td colspan="6">No alumni accounts found.</td></tr><% } %>
</tbody></table></div></section>
<section class="panel"><div class="section-head"><h2>Events</h2><a class="btn" href="/admin/events/new">Add Event</a></div><div class="table-wrap"><table class="admin-table"><thead><tr><th>Title</th><th>Date</th><th>Location</th><th>Actions</th></tr></thead><tbody>
<% events.forEach(event => { %><tr><td><%= event.title %></td><td><%= new Date(event.event_date).toLocaleString() %></td><td><%= event.location %></td><td><div class="admin-actions"><a class="btn" href="/admin/events/<%= event.id %>/edit">Edit</a><form method="POST" action="/admin/events/<%= event.id %>
<input type="hidden" name="_csrf" value="<%= csrfToken %>">/delete" onsubmit="return confirm('Delete this event?')"><button class="btn danger" type="submit">Delete</button></form></div></td></tr><% }) %>
<% if (!events.length) { %><tr><td colspan="4">No events found.</td></tr><% } %>
</tbody></table></div></section>
<section class="panel"><div class="section-head"><h2>Job Opportunities</h2><a class="btn" href="/admin/jobs/new">Add Job</a></div><div class="table-wrap"><table class="admin-table"><thead><tr><th>Title</th><th>Company</th><th>Location</th><th>Actions</th></tr></thead><tbody>
<% jobs.forEach(job => { %><tr><td><%= job.title %></td><td><%= job.company %></td><td><%= job.location || "Not specified" %></td><td><div class="admin-actions"><a class="btn" href="/admin/jobs/<%= job.id %>/edit">Edit</a><form method="POST" action="/admin/jobs/<%= job.id %>
<input type="hidden" name="_csrf" value="<%= csrfToken %>">/delete" onsubmit="return confirm('Delete this job?')"><button class="btn danger" type="submit">Delete</button></form></div></td></tr><% }) %>
<% if (!jobs.length) { %><tr><td colspan="4">No jobs found.</td></tr><% } %>
</tbody></table></div></section>
</main></div></body></html>